go_test(
    name = "fiberv3_test",
    srcs = ["petstore_test.go"],
    embed = [":fiberv3_lib"],
    deps = [
        "//examples/petstore-expanded/fiberv3/api",
        "@com_github_gofiber_fiber_v3//:fiber",
        "@com_github_stretchr_testify//assert",
    ],
